# ───────────────────────────────────────────
# DATABASE (SQLite — file lives in project root)
# ───────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ───────────────────────────────────────────
# JWT (generate with: openssl rand -base64 48)
# ───────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"

# ───────────────────────────────────────────
# GEMINI AI
# Get key at: https://aistudio.google.com/app/apikey
# ───────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"

# ───────────────────────────────────────────
# NODEMAILER — Gmail App Password
# Steps:
#   1. Enable 2FA on your Google account
#   2. Go to myaccount.google.com → Security → App Passwords
#   3. Create an App Password for "Mail"
#   4. Paste the 16-char password below (no spaces)
# ───────────────────────────────────────────
GMAIL_USER="your-gmail@gmail.com"
GMAIL_APP_PASSWORD="your16charapppassword"

# ───────────────────────────────────────────
# GOOGLE CALENDAR OAUTH
# Steps (see README for full guide):
#   1. Google Cloud Console → New Project → Enable Calendar API
#   2. APIs & Services → OAuth 2.0 → Create credentials (Web App)
#   3. Authorised redirect URI: http://localhost:3000/api/auth/google/callback
#   4. Copy Client ID and Client Secret below
# ───────────────────────────────────────────
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ───────────────────────────────────────────
# APP
# ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
